[user]
	name = Lucasscariot
	email = lucas@scariot.fr
	signingKey = /Users/lucasscariot/.ssh/id_ed25519.pub
[core]
	editor = code
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[diff]
 	algorithm = histogram
[alias]
	co = "commit -m"
	ca = "commit --amend --no-edit"
	cm = "commit -m"
	ca = "commit --amend --no-edit"
	staash = "stash --all"
	ds = "diff main --stat"
	gone = !git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | grep '\\[gone\\]'
	clean-gone = !git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | grep '\\[gone\\]' | awk '{print $1}' | xargs git branch -D
	branchd = !git branch -vv --format=\"%(refname:short)|%(objectname:short)|[%(upstream:short)]|%(committerdate:relative)|%(subject)\" | column -t -s \"|\"
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[column]
	ui = auto
[gpg]
	format = ssh
[maintenance]
	repo = /Users/lucasscariot/goinfre/massive-dynamic
[fetch]
	prune = true
